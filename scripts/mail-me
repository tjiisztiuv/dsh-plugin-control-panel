#!/usr/bin/python3
"""给自己发一封纯文本邮件：主题写在参数里，正文从标准输入读。

    echo "NAS 增量备份 12.3 GB" | mail-me "备份完成"
    mail-me -t someone@example.com "主题" < body.txt
    mail-me --dry-run "主题" < body.txt     # 只打印要发的信，不连服务器

发件走 QQ 邮箱 SMTP（smtp.qq.com:465）。Gmail 的 465/587 在本机代理那条线路上被封，
smtp.qq.com 走直连，收件人照样可以是 Gmail（详见 HappyLifeFinance/tools/daily_check/README.md
「发信通道」一节）。

配置在 ~/.config/mail-me/config.ini（环境变量 MAIL_ME_CONFIG 可以换一个文件）：

    [mail-me]
    to = 默认收件人
    credentials = ~/dev_code/HappyLifeFinance/conf/qq_mail.ini

凭据按这个顺序找：环境变量 QQ_MAIL_USER / QQ_MAIL_AUTH_CODE → `credentials` 指的文件 → 配置文件本身，
后两者都读 [qq_mail] 段的 user 和 auth_code。auth_code 是 QQ 邮箱「设置 → 账户 → POP3/IMAP/SMTP 服务」
生成的授权码，不是 QQ 密码。

退出码：0 已发出；1 发送失败（三次都没成）；2 用法或配置有问题。失败原因写在标准错误的最后一行。

只用 /usr/bin/python3（3.9）自带的标准库：从程序坞启动的应用和 launchd 都只有很短的 PATH，
也没有 venv，少一个依赖就少一个无人值守时的失败点。
"""
from __future__ import annotations

import argparse
import configparser
import os
import smtplib
import ssl
import sys
import time
from email.mime.text import MIMEText
from email.utils import formatdate, make_msgid

SMTP_HOST = "smtp.qq.com"
SMTP_PORT = 465
DEFAULT_CONFIG = "~/.config/mail-me/config.ini"
# 本机代理偶尔断一下（2026-08-13 有过一次 SSL EOF），几十秒后就好；重试比丢信便宜。
ATTEMPTS = 3
BACKOFF = (20, 60)


class ConfigError(Exception):
    pass


def read_ini(path: str) -> configparser.ConfigParser:
    cfg = configparser.ConfigParser(interpolation=None)
    try:
        with open(path, encoding="utf-8") as f:
            cfg.read_file(f)
    except FileNotFoundError:
        raise ConfigError(f"找不到 {path}")
    except (OSError, configparser.Error) as e:
        raise ConfigError(f"读不了 {path}：{e}")
    return cfg


def load_config() -> tuple[str, configparser.ConfigParser | None]:
    path = os.path.expanduser(os.environ.get("MAIL_ME_CONFIG") or DEFAULT_CONFIG)
    if not os.path.exists(path):
        return path, None
    return path, read_ini(path)


def credentials(config_path: str, cfg: configparser.ConfigParser | None) -> tuple[str, str]:
    """(发件地址, 授权码)。"""
    user = os.environ.get("QQ_MAIL_USER", "").strip()
    code = os.environ.get("QQ_MAIL_AUTH_CODE", "").strip()
    if user and code:
        return user, code
    sources = []
    if cfg is not None and cfg.get("mail-me", "credentials", fallback="").strip():
        sources.append(read_ini(os.path.expanduser(cfg.get("mail-me", "credentials").strip())))
    if cfg is not None:
        sources.append(cfg)
    for source in sources:
        user = user or source.get("qq_mail", "user", fallback="").strip()
        code = code or source.get("qq_mail", "auth_code", fallback="").strip()
    if not user or not code:
        raise ConfigError(
            f"缺少 QQ 邮箱凭据：在 {config_path} 的 [mail-me] 段写 credentials = <含 [qq_mail] user/auth_code 的文件>，"
            "或设置环境变量 QQ_MAIL_USER / QQ_MAIL_AUTH_CODE"
        )
    return user, code


def build_message(sender: str, to: str, subject: str, body: str) -> MIMEText:
    msg = MIMEText(body, "plain", "utf-8")
    msg["From"] = sender
    msg["To"] = to
    msg["Subject"] = subject
    msg["Date"] = formatdate(localtime=True)
    # 域名钉成发件域：make_msgid() 默认取 socket.getfqdn()，这台 Mac 上会退化成 ip6.arpa 一类的假域名，
    # 是 Gmail 垃圾过滤的扣分项（daily_check 2026-08-24 实测）。
    msg["Message-ID"] = make_msgid(domain=sender.split("@", 1)[-1])
    return msg


def send(msg: MIMEText, sender: str, code: str, to: str) -> None:
    context = ssl.create_default_context()
    with smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT, context=context, timeout=30) as s:
        s.login(sender, code)
        s.sendmail(sender, [to], msg.as_string())


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="mail-me", description="主题写在参数里，正文从标准输入读，经 QQ 邮箱 SMTP 发出。")
    parser.add_argument("subject", help="邮件主题")
    parser.add_argument("-t", "--to", help="收件人，默认用配置里的 to")
    parser.add_argument("--dry-run", action="store_true", help="只打印要发的信，不连服务器")
    args = parser.parse_args(argv)

    try:
        config_path, cfg = load_config()
        to = (args.to or (cfg.get("mail-me", "to", fallback="") if cfg is not None else "")).strip()
        if not to:
            raise ConfigError(f"不知道发给谁：用 -t 指定，或在 {config_path} 的 [mail-me] 段写 to = <收件人>")
        sender, code = credentials(config_path, cfg)
    except ConfigError as e:
        print(f"mail-me: {e}", file=sys.stderr)
        return 2

    body = "" if sys.stdin.isatty() else sys.stdin.buffer.read().decode("utf-8", errors="replace")
    msg = build_message(sender, to, args.subject.strip() or "(无主题)", body)
    if args.dry_run:
        sys.stdout.write(msg.as_string())
        sys.stdout.write("\n")
        return 0

    for attempt in range(ATTEMPTS):
        try:
            send(msg, sender, code, to)
            if attempt:
                print(f"mail-me: 第 {attempt + 1} 次尝试发出", file=sys.stderr)
            return 0
        except smtplib.SMTPAuthenticationError as e:
            # 授权码错了，重试也一样
            detail = e.smtp_error.decode("utf-8", errors="replace") if isinstance(e.smtp_error, bytes) else str(e.smtp_error)
            print(f"mail-me: QQ 邮箱登录失败，检查授权码：{e.smtp_code} {detail}", file=sys.stderr)
            return 1
        except Exception as e:
            reason = f"{type(e).__name__}: {e}"
            if attempt == ATTEMPTS - 1:
                print(f"mail-me: 发送失败（试了 {ATTEMPTS} 次）：{reason}", file=sys.stderr)
                return 1
            wait = BACKOFF[min(attempt, len(BACKOFF) - 1)]
            print(f"mail-me: 第 {attempt + 1} 次发送失败（{reason}），{wait}s 后重试", file=sys.stderr)
            time.sleep(wait)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
